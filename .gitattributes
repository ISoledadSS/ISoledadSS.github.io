# Normaliza finales de línea: LF en el repositorio, nativo al hacer checkout.
* text=auto

*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.md    text eol=lf
*.svg   text eol=lf

# Binarios: que git no intente convertirlos ni mostrarlos como diff.
*.png   binary
*.jpg   binary
*.pdf   binary
*.woff2 binary
